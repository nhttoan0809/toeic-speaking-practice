# Application Settings
APP_NAME=Chat API Service
APP_VERSION=1.0.0
HOST=0.0.0.0
PORT=8000
DEBUG=false
LOG_LEVEL=INFO

# CORS Settings
CORS_ALLOW_ORIGINS=*
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*

# LLM Configuration
LLM_FRAMEWORK=ollama
LLM_MODEL_NAME=mistral-small
LLM_TEMPERATURE=0.7
LLM_TOP_P=0.9
LLM_MAX_TOKENS=2048
LLM_CONTEXT_WINDOW=8192
LLM_SYSTEM_PROMPT=You are a helpful and intelligent AI assistant. Answer questions clearly and concisely.

# TTS Configuration
TTS_ENGINE=edge-tts
TTS_EDGE_VOICE=en-US-GuyNeural
TTS_EDGE_RATE=+0%
TTS_EDGE_VOLUME=+0%
TTS_EDGE_PITCH=+0Hz
TTS_OUTPUT_DIR=audio_output
TTS_OUTPUT_FORMAT=mp3

# Piper TTS (alternative, optional)
# TTS_PIPER_MODEL_PATH=/path/to/piper/model.onnx
